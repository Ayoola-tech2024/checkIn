generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  departments Department[]
  students    Student[]
  lecturers   Lecturer[]
  courses     Course[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id           String     @id @default(cuid())
  name         String     @unique
  code         String     @unique
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  students     Student[]
  lecturers    Lecturer[]  @relation("DeptLecturers")
  hodLecturers Lecturer[]  @relation("HodDepartment")
  courses      Course[]    @relation("DeptCourses")
  courseDepts  CourseDepartment[]
  sessionDepts SessionDepartment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Student {
  id           String     @id @default(cuid())
  name         String
  matricNumber String     @unique
  departmentId String
  schoolId     String
  level        Int        @default(100)
  email        String?
  passwordHash String?
  activated    Boolean    @default(false)
  facialData   String?
  selfieData   String?
  department   Department @relation(fields: [departmentId], references: [id])
  school       School     @relation(fields: [schoolId], references: [id])
  attendances  Attendance[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Lecturer {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  schoolId        String
  departmentId    String?
  isHod           Boolean    @default(false)
  hodDepartmentId String?
  passwordHash    String?
  department      Department? @relation("DeptLecturers", fields: [departmentId], references: [id])
  hodDepartment   Department? @relation("HodDepartment", fields: [hodDepartmentId], references: [id])
  school          School     @relation(fields: [schoolId], references: [id])
  courses         Course[]
  sessions        Session[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Course {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  level        Int        @default(100)
  schoolId     String
  departmentId String?
  lecturerId   String
  lecturer     Lecturer   @relation(fields: [lecturerId], references: [id])
  department   Department? @relation("DeptCourses", fields: [departmentId], references: [id])
  school       School     @relation(fields: [schoolId], references: [id])
  departments  CourseDepartment[]
  sessions     Session[]
  grading      CourseGrading[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CourseDepartment {
  id           String     @id @default(cuid())
  courseId     String
  departmentId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([courseId, departmentId])
}

model Venue {
  id        String   @id @default(cuid())
  name      String   @unique
  latitude  Float
  longitude Float
  sessions  Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id                String   @id @default(cuid())
  title             String
  courseId          String
  venueId           String
  lecturerId        String
  level             Int      @default(100)
  distanceThreshold Float    @default(50)
  durationMinutes   Int      @default(15)
  scheduledAt       DateTime
  startedAt         DateTime?
  endsAt            DateTime?
  status            String   @default("scheduled")
  lecturerLat       Float?
  lecturerLng       Float?
  course            Course   @relation(fields: [courseId], references: [id])
  venue             Venue    @relation(fields: [venueId], references: [id])
  lecturer          Lecturer @relation(fields: [lecturerId], references: [id])
  departments       SessionDepartment[]
  attendances       Attendance[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SessionDepartment {
  id           String     @id @default(cuid())
  sessionId    String
  departmentId String
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, departmentId])
}

model Attendance {
  id              String    @id @default(cuid())
  studentId       String
  sessionId       String
  status          String    @default("pending")
  similarityScore Float?
  checkInTime     DateTime?
  studentLat      Float?
  studentLng      Float?
  selfieData      String?
  student         Student   @relation(fields: [studentId], references: [id])
  session         Session   @relation(fields: [sessionId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, sessionId])
}

model Semester {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  grading   CourseGrading[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseGrading {
  id         String   @id @default(cuid())
  courseId   String
  semesterId String
  totalMarks Float   @default(0)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([courseId, semesterId])
}
